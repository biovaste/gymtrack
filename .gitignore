# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Claude Code local config (machine-specific)
.claude/launch.json
.claude/settings.local.json

# Cloudflare Worker build cache (contains account token) — any depth, not just worker/
.wrangler/

# Sync credentials — the UUID grants read, the token grants write. Never commit either.
.gymtrack-uuid
.gymtrack-write-token

# Logs / temp
*.log
tmp/

# Local translation reviewer session lock
locales/.review.lock
